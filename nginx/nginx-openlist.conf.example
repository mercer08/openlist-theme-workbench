# OpenList(雪人投研) 反代：主域名 pan.nickszy.com，旧域名 alist.nickszy.com 301 跳转
# upstream: 容器内部 127.0.0.1:15244
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# IP 直连入口
server {
    listen 5244;
    server_name _;

    client_max_body_size 0;

    # 品牌静态资源
    location = /logo.svg {
        root /var/www/alist-brand;
        expires 7d;
    }
    location = /favicon.svg {
        root /var/www/alist-brand;
        expires 7d;
    }

    # 带哈希文件名的静态资源，长缓存
    location /assets/ {
        proxy_pass http://127.0.0.1:15244;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:15244;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # 上传/下载流式直通，不经 nginx 缓冲
        proxy_buffering off;
        proxy_request_buffering off;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/x-javascript application/json application/xml application/xml+rss image/svg+xml application/wasm;

    listen [::]:5244;
}

# 主域名 pan.nickszy.com
server {
    server_name pan.nickszy.com;

    client_max_body_size 0;

    # 品牌静态资源
    location = /logo.svg {
        root /var/www/alist-brand;
        expires 7d;
    }
    location = /favicon.svg {
        root /var/www/alist-brand;
        expires 7d;
    }

    # 带哈希文件名的静态资源，长缓存
    location /assets/ {
        proxy_pass http://127.0.0.1:15244;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:15244;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/x-javascript application/json application/xml application/xml+rss image/svg+xml application/wasm;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pan.nickszy.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pan.nickszy.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

# 旧域名 301 到新域名
server {
    server_name alist.nickszy.com;
    return 301 https://pan.nickszy.com$request_uri;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/alist.nickszy.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/alist.nickszy.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    listen 80;
    server_name pan.nickszy.com;
    return 301 https://$host$request_uri;

}

server {
    if ($host = alist.nickszy.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name alist.nickszy.com;
    return 404; # managed by Certbot


}
